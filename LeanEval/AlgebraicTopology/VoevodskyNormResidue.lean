import Mathlib.LinearAlgebra.TensorPower.Basic
import TauCeti.FieldTheory.GaloisCohomology.Kummer
import TauCeti.RepresentationTheory.Homological.ContCohomology.Cup.Cohomology
import TauCeti.RepresentationTheory.Homological.ContCohomology.DegreeZero
import EvalTools.Markers

open CategoryTheory ContRepresentation

namespace LeanEval
namespace AlgebraicTopology

/-!
# Voevodsky's Norm Residue Isomorphism Theorem (Bloch–Kato Conjecture)

John Milnor (1970, *Invent. Math.* 9, 318–344, for $m = 2$) and Spencer Bloch
and Kazuya Kato (1986, *Publ. Math. Inst. Hautes Études Sci.* 63, 107–152, for
arbitrary $m$ invertible in $F$) conjectured that for every field $F$, every
integer $m$ invertible in $F$, and every degree $n \ge 0$, the *norm residue
homomorphism* (Galois symbol)
$$
  h_{F, m}^n : K_n^{\mathrm{M}}(F) / m K_n^{\mathrm{M}}(F)
    \longrightarrow H_{\mathrm{cont}}^n(G_F, \mu_m^{\otimes n}),
  \qquad \{u_1, \dots, u_n\} \longmapsto
    \kappa(u_1) \smile \cdots \smile \kappa(u_n),
$$
is an isomorphism of abelian groups (recovering Kummer theory for $n = 1$ and
the Merkurjev–Suslin theorem for $n = 2$).

Vladimir Voevodsky proved the Milnor conjecture ($m = 2$, 2003, *Publ. Math.
IHÉS* 98, 59–104; Fields Medal 2002) and completed the proof of the full
Bloch–Kato conjecture for all $m$ invertible in $F$ (2011, *Ann. of Math.* 174,
401–438), incorporating Markus Rost's construction of norm varieties (see also
Haesemeyer–Weibel, *The Norm Residue Theorem in Motivic Cohomology*, Annals of
Mathematics Studies 200, 2019).

Because pure Milnor symbols $\{u_0, \dots, u_{n-1}\}$ generate
$K_n^{\mathrm{M}}(F) / m K_n^{\mathrm{M}}(F)$, the norm residue homomorphism is
uniquely characterized as the additive homomorphism sending each pure symbol to
the iterated cup product of its Kummer classes. Stated against Tau Ceti's
`KummerCoeff`, `kummerMapCanonical`, and continuous-cohomology cup product.
-/

namespace VoevodskyNormResidue

variable (F : Type) [Field F]

/-- The $n$-th integral tensor power $(F^\times)^{\otimes_{\mathbb{Z}} n}$ of the
multiplicative group of units of $F$ (written additively). -/
abbrev UnitTensor (n : ℕ) : Type :=
  PiTensorProduct ℤ (fun _ : Fin n ↦ Additive Fˣ)

/-- The subgroup of $(F^\times)^{\otimes n}$ generated by Steinberg tensors
$u_0 \otimes \cdots \otimes u_{n-1}$ with $u_i + u_{i+1} = 1$ for some
$i + 1 < n$, together with all $m$-multiples. -/
def steinbergModSubgroup (m n : ℕ) : AddSubgroup (UnitTensor F n) :=
  AddSubgroup.closure
    ({t | ∃ (u : Fin n → Fˣ) (i : ℕ) (hi : i + 1 < n),
        (u ⟨i, Nat.lt_of_succ_lt hi⟩ : F) + (u ⟨i + 1, hi⟩ : F) = 1 ∧
        t = PiTensorProduct.tprod ℤ (fun j ↦ Additive.ofMul (u j))} ∪
      {t | ∃ x : UnitTensor F n, t = m • x})

/-- The mod-$m$ Milnor $K$-group $K_n^{\mathrm{M}}(F) / m K_n^{\mathrm{M}}(F)$. -/
abbrev MilnorKGroupMod (m n : ℕ) : Type :=
  UnitTensor F n ⧸ steinbergModSubgroup F m n

/-- The pure Milnor symbol $\{u_0, \dots, u_{n-1}\} \bmod m$ in
$K_n^{\mathrm{M}}(F) / m K_n^{\mathrm{M}}(F)$. -/
noncomputable def milnorSymbolMod (m n : ℕ) (u : Fin n → Fˣ) : MilnorKGroupMod F m n :=
  QuotientAddGroup.mk (PiTensorProduct.tprod ℤ (fun j ↦ Additive.ofMul (u j)))

/-- The $n$-th Tate twist $\mu_m^{\otimes n} =
\bigotimes_{\mathbb{Z}/m\mathbb{Z}}^n \mu_m(F^{\mathrm{s}})$. -/
abbrev TateTwist (m n : ℕ) : Type :=
  TensorPower (ZMod m) n (TauCeti.KummerCoeff F m)

/-- Discrete topology on $\mu_m^{\otimes n}$. -/
instance instTopologicalSpaceTateTwist (m n : ℕ) : TopologicalSpace (TateTwist F m n) := ⊥

/-- Discreteness instance for $\mu_m^{\otimes n}$. -/
instance instDiscreteTopologyTateTwist (m n : ℕ) : DiscreteTopology (TateTwist F m n) := ⟨rfl⟩

/-- Linear action of $g \in G_F$ on $\mu_m(F^{\mathrm{s}})$ over $\mathbb{Z}/m\mathbb{Z}$. -/
noncomputable def kummerActLin (m : ℕ) (g : TauCeti.AbsoluteGaloisGroup F) :
    TauCeti.KummerCoeff F m →ₗ[ZMod m] TauCeti.KummerCoeff F m :=
  ({ toFun := (g • ·), map_zero' := smul_zero g, map_add' := smul_add g } :
    TauCeti.KummerCoeff F m →+ TauCeti.KummerCoeff F m).toZModLinearMap (n := m)

/-- Diagonal $G_F$-action on $\mu_m^{\otimes n}$. -/
noncomputable instance instDistribMulActionTateTwist (m n : ℕ) :
    DistribMulAction (TauCeti.AbsoluteGaloisGroup F) (TateTwist F m n) :=
  let hom : TauCeti.AbsoluteGaloisGroup F →* (TateTwist F m n →ₗ[ZMod m] TateTwist F m n) :=
    { toFun := fun g ↦ PiTensorProduct.map (fun _ : Fin n ↦ kummerActLin F m g)
      map_one' := by
        have h1 : kummerActLin F m 1 = 1 := LinearMap.ext (one_smul (TauCeti.AbsoluteGaloisGroup F))
        simp only [h1]; exact PiTensorProduct.map_one
      map_mul' := fun g h ↦ by
        have hm : kummerActLin F m (g * h) = kummerActLin F m g * kummerActLin F m h :=
          LinearMap.ext (mul_smul g h)
        simp only [hm]; exact PiTensorProduct.map_mul _ _ }
  { smul := fun g x ↦ hom g x
    one_smul := fun x ↦ by change hom 1 x = x; rw [map_one]; rfl
    mul_smul := fun g h x ↦ by change hom (g * h) x = _; rw [map_mul]; rfl
    smul_zero := fun g ↦ map_zero (hom g)
    smul_add := fun g x y ↦ map_add (hom g) x y }

instance instSMulCommClassTateTwist (m n : ℕ) :
    SMulCommClass (TauCeti.AbsoluteGaloisGroup F) (ZMod m) (TateTwist F m n) :=
  ⟨fun g r x ↦ map_smul (PiTensorProduct.map (fun _ : Fin n ↦ kummerActLin F m g)) r x⟩

lemma tateTwist_smul_tprod {m n : ℕ} (g : TauCeti.AbsoluteGaloisGroup F)
    (f : Fin n → TauCeti.KummerCoeff F m) :
    g • PiTensorProduct.tprod (ZMod m) f =
      PiTensorProduct.tprod (ZMod m) (fun i ↦ g • f i) :=
  PiTensorProduct.map_tprod _ f

/-- Continuity of the diagonal $G_F$-action on discrete $\mu_m^{\otimes n}$. -/
instance instContinuousSMulTateTwist (m n : ℕ) :
    ContinuousSMul (TauCeti.AbsoluteGaloisGroup F) (TateTwist F m n) :=
  continuousSMul_iff_stabilizer_isOpen.mpr fun x ↦ by
    induction x using PiTensorProduct.induction_on with
    | smul_tprod r f =>
      let H : Subgroup (TauCeti.AbsoluteGaloisGroup F) :=
        ⨅ i : Fin n, MulAction.stabilizer (TauCeti.AbsoluteGaloisGroup F) (f i)
      have hH : IsOpen (H : Set (TauCeti.AbsoluteGaloisGroup F)) := by
        have hcoe : (H : Set (TauCeti.AbsoluteGaloisGroup F)) =
            ⋂ i : Fin n, (MulAction.stabilizer (TauCeti.AbsoluteGaloisGroup F) (f i) : Set _) := by
          ext g; simp [H]
        rw [hcoe]
        exact isOpen_iInter_of_finite fun i ↦
          continuousSMul_iff_stabilizer_isOpen.mp inferInstance (f i)
      refine Subgroup.isOpen_mono (H₁ := H) (fun g hg ↦ ?_) hH
      simp only [H, Subgroup.mem_iInf, MulAction.mem_stabilizer_iff] at hg ⊢
      rw [smul_comm, tateTwist_smul_tprod]; congr 2; exact funext hg
    | add x y hx hy =>
      refine Subgroup.isOpen_mono
        (H₁ := MulAction.stabilizer (TauCeti.AbsoluteGaloisGroup F) x ⊓
          MulAction.stabilizer (TauCeti.AbsoluteGaloisGroup F) y)
        (fun g hg ↦ ?_) (hx.inter hy)
      simp only [Subgroup.mem_inf, MulAction.mem_stabilizer_iff] at hg ⊢
      rw [smul_add, hg.1, hg.2]

/-- The smooth discrete $G_F$-representation $\mu_m^{\otimes n}$. -/
noncomputable abbrev tateTwistRep (m n : ℕ) : TopRep ℤ (TauCeti.AbsoluteGaloisGroup F) :=
  TauCeti.ofDiscreteModule ℤ (TauCeti.AbsoluteGaloisGroup F) (TateTwist F m n)

/-- Bilinear graded multiplication on Tate twists. -/
noncomputable def tateTwistMulLin (m a b : ℕ) :
    TateTwist F m a →ₗ[ZMod m] TateTwist F m b →ₗ[ZMod m] TateTwist F m (a + b) :=
  (TensorProduct.mk (ZMod m) _ _).compr₂
    (TensorPower.mulEquiv : _ ≃ₗ[ZMod m] TateTwist F m (a + b)).toLinearMap

/-- Graded multiplication on Tate twists as a biadditive homomorphism. -/
noncomputable def tateTwistMulBiadd (m a b : ℕ) :
    TateTwist F m a →+ TateTwist F m b →+ TateTwist F m (a + b) where
  toFun x := (tateTwistMulLin F m a b x).toAddMonoidHom
  map_zero' := by ext y; simp [tateTwistMulLin]
  map_add' x₁ x₂ := by ext y; simp [tateTwistMulLin]

/-- Equivariant pairing $\mu_m^{\otimes a} \times \mu_m^{\otimes b} \to \mu_m^{\otimes (a+b)}$. -/
noncomputable def tateTwistPairing (m a b : ℕ) :
    TauCeti.TopPairing (tateTwistRep F m a) (tateTwistRep F m b) (tateTwistRep F m (a + b)) :=
  TauCeti.ofDiscreteModulePairing (tateTwistMulBiadd F m a b) (fun g x y ↦ by
    induction x using PiTensorProduct.induction_on with
    | smul_tprod r f =>
      induction y using PiTensorProduct.induction_on with
      | smul_tprod s h =>
        have hsm (c d : ZMod m) (u : TateTwist F m a) (v : TateTwist F m b) :
            tateTwistMulBiadd F m a b (c • u) (d • v) =
              (c * d) • tateTwistMulBiadd F m a b u v := by
          change tateTwistMulLin F m a b (c • u) (d • v) =
            (c * d) • tateTwistMulLin F m a b u v
          rw [LinearMap.map_smul₂, map_smul, smul_smul]
        have htp (p : Fin a → TauCeti.KummerCoeff F m) (q : Fin b → TauCeti.KummerCoeff F m) :
            tateTwistMulBiadd F m a b (PiTensorProduct.tprod (ZMod m) p)
              (PiTensorProduct.tprod (ZMod m) q) =
              PiTensorProduct.tprod (ZMod m) (Fin.append p q) :=
          TensorPower.tprod_mul_tprod (ZMod m) p q
        rw [smul_comm g r, smul_comm g s, hsm, hsm, smul_comm g (r * s),
          tateTwist_smul_tprod, tateTwist_smul_tprod, htp, htp, tateTwist_smul_tprod]
        congr 2; ext k; refine Fin.addCases (fun i ↦ by simp) (fun j ↦ by simp) k
      | add y₁ y₂ hy₁ hy₂ => rw [smul_add, map_add, map_add, smul_add, hy₁, hy₂]
    | add x₁ x₂ hx₁ hx₂ =>
      rw [smul_add, map_add, AddMonoidHom.add_apply, map_add, AddMonoidHom.add_apply,
        smul_add, hx₁, hx₂])

/-- Morphism $\mu_m(F^{\mathrm{s}}) \to \mu_m^{\otimes 1}$ sending $y$ to the
length-$1$ pure tensor. -/
noncomputable def toTateTwistOne (m : ℕ) :
    TauCeti.ofDiscreteModule ℤ (TauCeti.AbsoluteGaloisGroup F) (TauCeti.KummerCoeff F m) ⟶
      tateTwistRep F m 1 :=
  TauCeti.ofDiscreteModuleMap
    ((PiTensorProduct.subsingletonEquiv (0 : Fin 1) :
      TateTwist F m 1 ≃ₗ[ZMod m] TauCeti.KummerCoeff F m).symm.toAddEquiv.toAddMonoidHom.toIntLinearMap)
    (fun g y ↦ by
      let e : TateTwist F m 1 ≃ₗ[ZMod m] TauCeti.KummerCoeff F m :=
        PiTensorProduct.subsingletonEquiv (0 : Fin 1)
      change e.symm (g • y) = g • e.symm y
      rw [PiTensorProduct.subsingletonEquiv_symm_apply',
        PiTensorProduct.subsingletonEquiv_symm_apply', tateTwist_smul_tprod])

/-- Degree-$1$ Kummer class in $H_{\mathrm{cont}}^1(G_F, \mu_m^{\otimes 1})$. -/
noncomputable def kummerClassOne (m : ℕ) (hm : IsUnit (m : F)) (u : Fˣ) :
    continuousCohomology 1 (tateTwistRep F m 1) :=
  (TauCeti.ContinuousCohomology.coeffMap (toTateTwistOne F m) 1).hom
    (Multiplicative.toAdd (TauCeti.kummerMapCanonical F m hm u))

/-- The iterated cup product $\kappa(u_0) \smile \cdots \smile \kappa(u_{n-1}) \in
H_{\mathrm{cont}}^n(G_F, \mu_m^{\otimes n})$ of the Kummer classes of
$u_0, \dots, u_{n-1} \in F^\times$. -/
noncomputable def iteratedKummerCup (m : ℕ) (hm : IsUnit (m : F)) :
    (n : ℕ) → (Fin n → Fˣ) → continuousCohomology n (tateTwistRep F m n)
  | 0, _ =>
      TauCeti.ContinuousCohomology.degreeZeroClass (tateTwistRep F m 0)
        (PiTensorProduct.tprod (ZMod m) (Fin.elim0 : Fin 0 → TauCeti.KummerCoeff F m))
        (fun g ↦ by
          change g • PiTensorProduct.tprod (ZMod m) (Fin.elim0 : Fin 0 → TauCeti.KummerCoeff F m) =
            PiTensorProduct.tprod (ZMod m) (Fin.elim0 : Fin 0 → TauCeti.KummerCoeff F m)
          rw [tateTwist_smul_tprod]; congr; ext i; exact i.elim0)
  | k + 1, u =>
      (tateTwistPairing F m k 1).cup k 1
        (iteratedKummerCup m hm k (Fin.init u))
        (kummerClassOne F m hm (u (Fin.last k)))

end VoevodskyNormResidue

/-- **Voevodsky's norm residue isomorphism theorem (Bloch–Kato conjecture).**
For every field $F$, every natural number $m$ invertible in $F$, and every
$n \in \mathbb{N}$, there is an isomorphism of abelian groups
$K_n^{\mathrm{M}}(F) / m K_n^{\mathrm{M}}(F) \xrightarrow{\sim}
H_{\mathrm{cont}}^n(G_F, \mu_m^{\otimes n})$ mapping every pure Milnor symbol
$\{u_0, \dots, u_{n-1}\} \bmod m$ to the iterated cup product
$\kappa(u_0) \smile \cdots \smile \kappa(u_{n-1})$ of Kummer classes. -/
@[eval_problem]
theorem voevodsky_norm_residue
    (F : Type) [Field F] {m : ℕ} (hm : IsUnit (m : F)) (n : ℕ) :
    ∃ e : VoevodskyNormResidue.MilnorKGroupMod F m n ≃+
        continuousCohomology n (VoevodskyNormResidue.tateTwistRep F m n),
      ∀ u : Fin n → Fˣ,
        e (VoevodskyNormResidue.milnorSymbolMod F m n u) =
          VoevodskyNormResidue.iteratedKummerCup F m hm n u := by
  sorry

end AlgebraicTopology
end LeanEval
