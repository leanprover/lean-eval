import Mathlib
import EvalTools.Markers

open Cardinal FirstOrder Set

namespace LeanEval
namespace SetTheory

universe u

/-!
# The Martin–Steel Projective Determinacy Theorem

Donald A. Martin and John R. Steel (1989, *A proof of projective determinacy*,
*J. Amer. Math. Soc.* 2, 71–125, Main Theorem) established the central bridge
between large cardinals and descriptive set theory: for every integer $n \ge 1$,
if there exist $n$ Woodin cardinals $\delta_0 < \cdots < \delta_{n-1}$ below a
measurable cardinal $\kappa$, then every $\boldsymbol{\Pi}^1_{n+1}$ subset of
Baire space $\mathcal{N} = \mathbb{N}^{\mathbb{N}}$ is determined (i.e. one of
the two players has a winning strategy in the infinite Gale–Stewart game with
payoff $A$). In particular, if there exist infinitely many Woodin cardinals,
then full Projective Determinacy ($\mathrm{PD}$) holds.

Stated purely in Mathlib using `Cardinal`, `Ultrafilter`, `ZFSet`, and
`FirstOrder.Language`.
-/

namespace MartinSteelProjectiveDeterminacy

/-- Interleaving homeomorphism $\mathcal{N} \times \mathcal{N} \to \mathcal{N}$
on Baire space $\mathcal{N} = \mathbb{N}^{\mathbb{N}}$. -/
def pairBaire (p : (ℕ → ℕ) × (ℕ → ℕ)) (k : ℕ) : ℕ :=
  if k % 2 = 0 then p.1 (k / 2) else p.2 (k / 2)

/-- Boldface projective hierarchy $\boldsymbol{\Sigma}^1_n(\mathcal{N})$ on
Baire space $\mathbb{N}^{\mathbb{N}}$ (with $\boldsymbol{\Sigma}^1_0$ = open
sets, $\boldsymbol{\Pi}^1_n$ = complements of $\boldsymbol{\Sigma}^1_n$, and
$\boldsymbol{\Sigma}^1_{n+1}$ = projections along $\mathcal{N} \times \mathcal{N} \to \mathcal{N}$
of $\boldsymbol{\Pi}^1_n$ sets; Kechris, *Classical Descriptive Set Theory*,
Definition 37.1). -/
def IsProjectiveSigma : ℕ → Set (ℕ → ℕ) → Prop
  | 0, A => IsOpen A
  | n + 1, A =>
      ∃ B : Set (ℕ → ℕ), IsProjectiveSigma n Bᶜ ∧ A = Prod.fst '' (pairBaire ⁻¹' B)

/-- Boldface pointclass $\boldsymbol{\Pi}^1_n(\mathcal{N})$: complements of
$\boldsymbol{\Sigma}^1_n(\mathcal{N})$ sets. -/
def IsProjectivePi (n : ℕ) (A : Set (ℕ → ℕ)) : Prop :=
  IsProjectiveSigma n Aᶜ

/-- Finite play prefix of length $k$ generated by a strategy $\sigma$ for
Player I (moving at even lengths) against a strategy $\tau$ for Player II
(moving at odd lengths) in a Gale–Stewart game on $\mathbb{N}$. -/
def playPrefix (σ τ : List ℕ → ℕ) : ℕ → List ℕ
  | 0 => []
  | k + 1 =>
      let s := playPrefix σ τ k
      s ++ [if k % 2 = 0 then σ s else τ s]

/-- Infinite outcome play $(\sigma * \tau) : \mathbb{N} \to \mathbb{N}$ of
Player I strategy $\sigma$ against Player II strategy $\tau$. -/
def strategicPlay (σ τ : List ℕ → ℕ) (k : ℕ) : ℕ :=
  if k % 2 = 0 then σ (playPrefix σ τ k) else τ (playPrefix σ τ k)

/-- A payoff set $A \subseteq \mathbb{N}^{\mathbb{N}}$ is *determined* if either
Player I has a strategy winning against every Player II strategy (forcing the
play into $A$) or Player II has a strategy winning against every Player I
strategy (forcing the play into $A^c$). -/
def IsDetermined (A : Set (ℕ → ℕ)) : Prop :=
  (∃ σ : List ℕ → ℕ, ∀ τ : List ℕ → ℕ, strategicPlay σ τ ∈ A) ∨
  (∃ τ : List ℕ → ℕ, ∀ σ : List ℕ → ℕ, strategicPlay σ τ ∉ A)

/-- A cardinal $\kappa$ is *measurable* if $\kappa > \aleph_0$ and there exists
a nonprincipal $\kappa$-complete ultrafilter on a type of cardinality $\kappa$. -/
def IsMeasurableCardinal (κ : Cardinal.{u}) : Prop :=
  ℵ₀ < κ ∧ ∃ U : Ultrafilter κ.ord.ToType,
    (∀ x : κ.ord.ToType, ({x} : Set κ.ord.ToType)ᶜ ∈ (U : Filter κ.ord.ToType)) ∧
    ∀ (ι : Type u), #ι < κ → ∀ F : ι → Set κ.ord.ToType,
      (∀ i, F i ∈ (U : Filter κ.ord.ToType)) → (⋂ i, F i) ∈ (U : Filter κ.ord.ToType)

/-- The first-order language of set theory $\{\in\}$. -/
def setLang : FirstOrder.Language.{0, 0} where
  Functions _ := Empty
  Relations
    | 2 => PUnit
    | _ => Empty

/-- Any class $M \subseteq V$ of ZFC sets is a `setLang`-structure under `∈`. -/
instance instSetLangStructure (M : Set ZFSet.{u}) : setLang.Structure M where
  funMap f := f.elim
  RelMap {n} r v :=
    match n, r with
    | 2, PUnit.unit => (v 0).1 ∈ (v 1).1

/-- A map $j : V \to V$ is an elementary embedding from $V$ into a transitive
class $M$ with critical point $\kappa$ if $j(V) \subseteq M$, $j$ preserves
truth of all first-order $\{\in\}$-formulas, $j(\xi) = \xi$ for all $\xi < \kappa$,
and $\kappa < j(\kappa)$ (i.e. $\kappa \in j(\kappa)$). -/
def HasCriticalPoint (M : Set ZFSet.{u}) (j : ZFSet.{u} → ZFSet.{u})
    (κ : Ordinal.{u}) : Prop :=
  (∀ x ∈ M, ∀ y ∈ x, y ∈ M) ∧
  (∃ hj : ∀ x, j x ∈ M,
    ∀ ⦃m : ℕ⦄ (φ : setLang.BoundedFormula Empty m) (xs : Fin m → (univ : Set ZFSet.{u})),
      φ.Realize Empty.elim xs ↔
        φ.Realize Empty.elim (fun i ↦ (⟨j (xs i).1, hj (xs i).1⟩ : M))) ∧
  (∀ ξ < κ, j ξ.toZFSet = ξ.toZFSet) ∧
  κ.toZFSet ∈ j κ.toZFSet

/-- Set-theoretic Kuratowski graph $\{(\xi, f(\xi)) \mid \xi < \delta\}$ of an
ordinal function $f$ restricted to $\delta$. -/
noncomputable def ordinalFuncGraph (δ : Ordinal.{u}) (f : Ordinal.{u} → Ordinal.{u}) :
    ZFSet.{u} :=
  ZFSet.iUnion fun ξ : Iio δ ↦ {ZFSet.pair ξ.1.toZFSet (f ξ.1).toZFSet}

/-- A cardinal $\delta$ is a *Woodin cardinal* (Kanamori, *The Higher Infinite*,
Theorem 26.14) if for every $f : \delta \to \delta$ there exist an ordinal
$\kappa < \delta$ closed under $f$ and an elementary embedding $j : V \to M$
into a transitive class $M$ with critical point $\kappa$ such that
$V_{j(f)(\kappa)} \subseteq M$. -/
def IsWoodinCardinal (δ : Cardinal.{u}) : Prop :=
  ∀ f : Ordinal.{u} → Ordinal.{u}, (∀ ξ < δ.ord, f ξ < δ.ord) →
    ∃ κ < δ.ord, (∀ ξ < κ, f ξ < κ) ∧
      ∃ (M : Set ZFSet.{u}) (j : ZFSet.{u} → ZFSet.{u}) (η : Ordinal.{u}),
        HasCriticalPoint M j κ ∧
        ZFSet.pair κ.toZFSet η.toZFSet ∈ j (ordinalFuncGraph δ.ord f) ∧
        ∀ x ∈ ZFSet.vonNeumann η, x ∈ M

end MartinSteelProjectiveDeterminacy

/-- **Martin–Steel projective determinacy theorem.** If $n \ge 1$ and there
exist $n$ strictly increasing Woodin cardinals $\delta_0 < \cdots < \delta_{n-1}$
strictly below a measurable cardinal $\kappa$, then every
$\boldsymbol{\Pi}^1_{n+1}$ subset of Baire space $\mathbb{N}^{\mathbb{N}}$ is
determined. -/
@[eval_problem]
theorem martin_steel_projective_determinacy {n : ℕ} (hn : 1 ≤ n)
    {δ : Fin n → Cardinal.{u}} {κ : Cardinal.{u}}
    (hmono : StrictMono δ)
    (hwoodin : ∀ i : Fin n, MartinSteelProjectiveDeterminacy.IsWoodinCardinal (δ i))
    (hlt : ∀ i : Fin n, δ i < κ)
    (hκ : MartinSteelProjectiveDeterminacy.IsMeasurableCardinal κ)
    {A : Set (ℕ → ℕ)} (hA : MartinSteelProjectiveDeterminacy.IsProjectivePi (n + 1) A) :
    MartinSteelProjectiveDeterminacy.IsDetermined A := by
  sorry

end SetTheory
end LeanEval
