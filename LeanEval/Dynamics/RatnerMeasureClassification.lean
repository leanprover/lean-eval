import Mathlib.Dynamics.Ergodic.Action.Basic
import Mathlib.MeasureTheory.Group.Measure
import Mathlib.MeasureTheory.Measure.Support
import TauCeti.Geometry.Lie.Adjoint.Basic
import EvalTools.Markers

open MeasureTheory Set
open scoped ContDiff Manifold

namespace LeanEval
namespace Dynamics

/-!
# Ratner's Measure Classification Theorem (Raghunathan's Measure Conjecture)

Marina Ratner (1991, *On Raghunathan's measure conjecture*, *Ann. of Math.* (2)
134, 545–607, Theorems 1 and 3; see also Witte Morris, *Ratner's Theorems on
Unipotent Flows*, Chicago Lectures in Math., 2005, Theorem 1.1.3') proved that
for every connected finite-dimensional real Lie group $G$, every discrete
subgroup $\Gamma \le G$, and every connected subgroup $U \le G$ generated by
continuous $\mathrm{Ad}$-unipotent one-parameter subgroups, every $U$-invariant,
$U$-ergodic Borel probability measure $\nu$ on the homogeneous space $G / \Gamma$
is *algebraic* (homogeneous): there exist a closed connected subgroup $L \ge U$
and a point $x \in G / \Gamma$ such that the orbit $L \cdot x$ is closed, $\nu$
is $L$-invariant, and $\nu$ is concentrated on $L \cdot x$ with
$\mathrm{supp}(\nu) = L \cdot x$.
-/

namespace RatnerMeasureClassification

/-- An element $u$ of a real Lie group $G$ is $\mathrm{Ad}$-unipotent if
$\mathrm{Ad}(u) - \mathrm{id}$ is nilpotent on the Lie algebra $\mathfrak{g}$. -/
def IsAdUnipotent
    {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {H : Type} [TopologicalSpace H] (I : ModelWithCorners ℝ E H)
    {G : Type} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G]
    (u : G) : Prop :=
  IsNilpotent (TauCeti.Lie.adjointContinuousLinearMap (I := I) u -
    ContinuousLinearMap.id ℝ (GroupLieAlgebra I G))

/-- A subgroup $U \le G$ is generated by continuous one-parameter subgroups
consisting of $\mathrm{Ad}$-unipotent elements. -/
def IsAdUnipotentOneParamGenerated
    {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {H : Type} [TopologicalSpace H] (I : ModelWithCorners ℝ E H)
    {G : Type} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G]
    (U : Subgroup G) : Prop :=
  U = Subgroup.closure {u : G | ∃ φ : Multiplicative ℝ →* G,
    Continuous φ ∧ (∀ t, IsAdUnipotent I (φ t)) ∧ φ.range ≤ U ∧ u ∈ φ.range}

end RatnerMeasureClassification

/-- **Ratner's measure classification theorem.** Let $G$ be a connected
second-countable finite-dimensional real Lie group, $\Gamma \le G$ a discrete
subgroup, and $U \le G$ a subgroup generated by continuous one-parameter
$\mathrm{Ad}$-unipotent subgroups. Every $U$-invariant, $U$-ergodic Borel
probability measure $\nu$ on $G / \Gamma$ is invariant under some closed
connected subgroup $L \ge U$ and concentrated on a single closed orbit
$L \cdot x = \mathrm{supp}(\nu)$. -/
@[eval_problem]
theorem ratner_measure_classification
    {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    {H : Type} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
    {G : Type} [TopologicalSpace G] [T2Space G] [SecondCountableTopology G]
    [ChartedSpace H G] [Group G] [LieGroup I ∞ G] [ConnectedSpace G]
    (Γ : Subgroup G) [DiscreteTopology Γ]
    [MeasurableSpace (G ⧸ Γ)] [BorelSpace (G ⧸ Γ)]
    (U : Subgroup G) (hU : RatnerMeasureClassification.IsAdUnipotentOneParamGenerated I U)
    (ν : Measure (G ⧸ Γ)) [IsProbabilityMeasure ν] [ErgodicSMul U (G ⧸ Γ) ν] :
    ∃ (L : Subgroup G) (x : G ⧸ Γ),
      U ≤ L ∧ IsClosed (L : Set G) ∧ IsConnected (L : Set G) ∧
      IsClosed (MulAction.orbit L x) ∧
      SMulInvariantMeasure L (G ⧸ Γ) ν ∧
      ν (MulAction.orbit L x)ᶜ = 0 ∧
      ν.support = MulAction.orbit L x := by
  sorry

end Dynamics
end LeanEval
