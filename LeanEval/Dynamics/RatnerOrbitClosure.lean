import Mathlib.MeasureTheory.Group.Action
import Mathlib.MeasureTheory.Group.Measure
import Mathlib.MeasureTheory.Measure.Support
import TauCeti.Geometry.Lie.Adjoint.Basic
import EvalTools.Markers

open MeasureTheory Set
open scoped ContDiff Manifold

namespace LeanEval
namespace Dynamics

/-!
# Ratner's Topological Orbit-Closure Theorem (Raghunathan's Topological Conjecture)

Marina Ratner (1991, *Raghunathan's topological conjecture and distributions of
unipotent flows*, *Duke Math. J.* 63, 235–280, Theorem A) proved that if $G$ is
a connected finite-dimensional real Lie group, $\Gamma \le G$ is a lattice (a
discrete subgroup such that $G / \Gamma$ carries a $G$-invariant Borel
probability measure), and $U \le G$ is generated by continuous
$\mathrm{Ad}$-unipotent one-parameter subgroups, then for every point
$x \in G / \Gamma$ the orbit closure $\overline{U \cdot x}$ coincides with a
single closed orbit $L \cdot x$ of a closed connected subgroup $L \ge U$
admitting an $L$-invariant Borel probability measure supported on $L \cdot x$.
-/

namespace RatnerOrbitClosure

/-- An element $u$ of a real Lie group $G$ is $\mathrm{Ad}$-unipotent if
$\mathrm{Ad}(u) - \mathrm{id}$ is nilpotent on the Lie algebra $\mathfrak{g}$. -/
def IsAdUnipotent
    {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {H : Type} [TopologicalSpace H] (I : ModelWithCorners ℝ E H)
    {G : Type} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G]
    (u : G) : Prop :=
  IsNilpotent (TauCeti.Lie.adjointContinuousLinearMap (I := I) u -
    ContinuousLinearMap.id ℝ (GroupLieAlgebra I G))

/-- A subgroup $U \le G$ is generated by continuous one-parameter subgroups
consisting of $\mathrm{Ad}$-unipotent elements. -/
def IsAdUnipotentOneParamGenerated
    {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {H : Type} [TopologicalSpace H] (I : ModelWithCorners ℝ E H)
    {G : Type} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G]
    (U : Subgroup G) : Prop :=
  U = Subgroup.closure {u : G | ∃ φ : Multiplicative ℝ →* G,
    Continuous φ ∧ (∀ t, IsAdUnipotent I (φ t)) ∧ φ.range ≤ U ∧ u ∈ φ.range}

end RatnerOrbitClosure

/-- **Ratner's topological orbit-closure theorem.** Let $G$ be a connected
second-countable finite-dimensional real Lie group, $\Gamma \le G$ a lattice
(a discrete subgroup such that $G / \Gamma$ carries a $G$-invariant Borel
probability measure), and $U \le G$ a subgroup generated by continuous
one-parameter $\mathrm{Ad}$-unipotent subgroups. For every $x \in G / \Gamma$,
$\overline{U \cdot x} = L \cdot x$ for some closed connected subgroup $L \ge U$
admitting an $L$-invariant Borel probability measure $\nu$ on $G / \Gamma$
concentrated on $L \cdot x$ with $\mathrm{supp}(\nu) = L \cdot x$. -/
@[eval_problem]
theorem ratner_orbit_closure
    {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    {H : Type} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
    {G : Type} [TopologicalSpace G] [T2Space G] [SecondCountableTopology G]
    [ChartedSpace H G] [Group G] [LieGroup I ∞ G] [ConnectedSpace G]
    (Γ : Subgroup G) [DiscreteTopology Γ]
    [MeasurableSpace (G ⧸ Γ)] [BorelSpace (G ⧸ Γ)]
    (hΓ : ∃ m : Measure (G ⧸ Γ), IsProbabilityMeasure m ∧ SMulInvariantMeasure G (G ⧸ Γ) m)
    (U : Subgroup G) (hU : RatnerOrbitClosure.IsAdUnipotentOneParamGenerated I U)
    (x : G ⧸ Γ) :
    ∃ (L : Subgroup G) (ν : Measure (G ⧸ Γ)),
      U ≤ L ∧ IsClosed (L : Set G) ∧ IsConnected (L : Set G) ∧
      closure (MulAction.orbit U x) = MulAction.orbit L x ∧
      IsProbabilityMeasure ν ∧ SMulInvariantMeasure L (G ⧸ Γ) ν ∧
      ν (MulAction.orbit L x)ᶜ = 0 ∧ ν.support = MulAction.orbit L x := by
  sorry

end Dynamics
end LeanEval
